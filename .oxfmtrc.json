{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"tabWidth": 2,
	"printWidth": 80,
	"singleQuote": false,
	"trailingComma": "all",
	"semi": true,
	"arrowParens": "always",
	"sortImports": {},
	"ignorePatterns": [
		"src/routeTree.gen.ts",
		"src/components/ui",
		"src/styles.css"
	]
}
