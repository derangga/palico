{
  "name": "palico",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build && bun scripts/finish-prerender.ts && bun scripts/build-sw.ts",
    "preview": "vite preview",
    "test": "bun run i18n && vitest run",
    "format": "oxfmt src vite.config.ts",
    "lint": "oxlint",
    "check": "oxlint --report-unused-disable-directives && oxfmt --check src vite.config.ts",
    "typecheck": "bun run i18n && tsc --noEmit",
    "deploy": "bun run build && wrangler deploy --config wrangler.deploy.jsonc",
    "doctor": "npx react-doctor@latest",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy baseLocale --disable-async-local-storage"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@cloudflare/vite-plugin": "1.42.2",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@fontsource-variable/nunito": "5.2.7",
    "@huggingface/transformers": "3.8.1",
    "@neslinesli93/qpdf-wasm": "0.3.1",
    "@pierre/diffs": "1.2.12",
    "@tailwindcss/vite": "4.3.1",
    "@tanstack/react-devtools": "0.10.8",
    "@tanstack/react-router": "1.170.16",
    "@tanstack/react-router-devtools": "1.167.0",
    "@tanstack/react-start": "1.168.26",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "effect": "4.1.2",
    "fflate": "0.8.3",
    "lucide-react": "1.21.0",
    "mermaid": "11.16.0",
    "next-themes": "0.4.6",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.1.200",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "shadcn": "4.11.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.1",
    "tw-animate-css": "1.4.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@catppuccin/tailwindcss": "1.0.0",
    "@effect/language-service": "0.87.5",
    "@inlang/paraglide-js": "3.2.0",
    "@inlang/plugin-message-format": "4.6.0",
    "@oxlint/plugins": "1.91.0",
    "@tailwindcss/typography": "0.5.20",
    "@tanstack/devtools-vite": "0.8.1",
    "@tanstack/router-cli": "1.167.17",
    "@types/node": "22.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "28.1.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "react-doctor": "0.5.8",
    "typescript": "6.0.3",
    "vite": "8.1.0",
    "vitest": "4.1.9",
    "workbox-build": "7.4.1",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "wrangler": "4.104.0",
    "zetajs": "1.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
