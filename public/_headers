# The site deploys as static assets (SPA mode) with no rendering Worker, so the
# document's cross-origin-isolation headers — which src/server.ts used to set on
# the SSR response — must live here. Without COOP:same-origin + COEP:require-corp
# on the HTML document, crossOriginIsolated stays false and SharedArrayBuffer
# (multi-threaded ffmpeg.wasm) is unavailable. Applied to every prerendered page
# and the 404 page, which are all static files.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# Built workers (image-converter, ffmpeg classWorker, pdf, …) load into the
# cross-origin-isolated document, so they need Cross-Origin-Resource-Policy.
# COEP is NOT repeated here: the /* rule already applies it, and Cloudflare
# COMBINES matching rules — a second COEP line yields "require-corp, require-corp",
# an invalid multi-item value that Chrome rejects, so the worker gets blocked
# ("COEP-framed resource needs COEP header"). CORP only.
# Every file here has a content hash in its name, so it can be cached forever.
# The service worker's install then reuses chunks the page already fetched
# (dontCacheBustURLsMatching in scripts/build-sw.ts).
/assets/*
  Cross-Origin-Resource-Policy: same-origin
  Cache-Control: public, max-age=31536000, immutable

# The vendored ZetaOffice runtime (Office → PDF) is served from /vendor/* and
# loaded as ES modules on the main thread and inside LibreOffice's pthread
# worker. Same CORP reasoning as /assets/* above (COEP comes from /*). (In dev,
# vite.config.ts's serveVendorStatic applies these instead.)
/vendor/*
  Cross-Origin-Resource-Policy: same-origin

# The shell is a fallback for the service worker, not a page. It is a copy of Home,
# so keep it out of search results. (404.html returns status 404 and needs no tag.)
/_shell
  X-Robots-Tag: noindex
/_shell.html
  X-Robots-Tag: noindex

# The service worker script must never be served from a stale HTTP cache, or a
# fixed worker would take up to 24 h to reach users. (COOP/COEP come from /*.)
/sw.js
  Cache-Control: no-cache
