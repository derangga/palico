# The site deploys as static assets (SPA mode) with no rendering Worker, so the
# document's cross-origin-isolation headers — which src/server.ts used to set on
# the SSR response — must live here. Without COOP:same-origin + COEP:require-corp
# on the HTML document, crossOriginIsolated stays false and SharedArrayBuffer
# (multi-threaded ffmpeg.wasm) is unavailable. Applied to every route since the
# SPA fallback serves index.html for all paths.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# Cloudflare Workers Assets serves /assets/* directly, bypassing src/server.ts,
# so the COOP/COEP headers set there never reach these files. The document is
# cross-origin isolated (Cross-Origin-Embedder-Policy: require-corp), and a
# module worker can only be loaded into such a context if its own script
# response carries a matching COEP header — otherwise the browser blocks it with
# net::ERR_BLOCKED_BY_RESPONSE ("Image worker crashed."). Tag every built asset
# so the image-converter worker (and other bundled workers) load under COEP.
/assets/*
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin

# The vendored ZetaOffice runtime (Office → PDF) is served from /vendor/* and
# loaded as ES modules on the main thread and inside LibreOffice's pthread
# worker. Same COEP/CORP reasoning as /assets/* above so it loads under the
# cross-origin-isolated document. (In dev, vite.config.ts's serveVendorStatic
# applies these instead.)
/vendor/*
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin
